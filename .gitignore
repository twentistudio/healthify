# Environment files - PENTING! Berisi API keys sensitif
.env*
!.env.example

# Python virtual environment
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Django specific
backend/db.sqlite3
# NOTE: Migrations HARUS di-commit ke git untuk production deployment
# Jangan ignore migrations!

# Frontend dependencies dan build
frontend/node_modules
frontend/dist/
frontend/build/
frontend/.vite/
frontend/coverage/
frontend/*json

# Frontend logs
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*
frontend/lerna-debug.log*

# Training data - File besar dan tidak perlu
training/data/raw/
training/data/chunks/
training/data/processed/
training/models/
training/checkpoints/
training/logs/

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
*.tmp

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
cache/

/training/data/pdf/*.pdf
/training/data/txt/*.txt
/training/scripts/__pycache__/
/training/scripts/*.pyc

training/docker-compose.yml

/training/data/
/training/data/metadata/
/training/data/raw/
/training/data/chunks/
/training/data/processed/

# CATATAN: baris `backend/api/migrations/` DIHAPUS.
# Aturan itu bertentangan dengan catatan di bagian 'Django specific' di atas
# dan membuat migrasi baru tidak pernah ter-commit — akibatnya `manage.py migrate`
# di produksi tidak membuat tabel baru dan endpoint terkait gagal 500.
# Migrasi 0001-0015 sudah tracked sejak sebelumnya sehingga tidak terdampak;
# 0016 dan seterusnya kini ter-commit dengan benar.
