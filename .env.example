# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,your-vps-ip

# Database
DB_HOST=db
DB_PORT=5432
DB_NAME=healtify_db
DB_USER=healtify_user
DB_PASSWORD=your-strong-password

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
ADMIN_NOTIFICATION_EMAILS=admin@example.com

# API Keys (Training)
# Boleh GEMINI_API atau GEMINI_API_KEY — settings.py menyelaraskan keduanya.
GEMINI_API_KEY=your_gemini_api_key
NCBI_API_KEY=your_ncbi_api_key
ELSEVIER_API_KEY=your_elsevier_api_key
GOOGLE_BOOKS_API_KEY=your_google_books_api_key
CROSSREF_MAILTO=11231072@student.itk.ac.id
S2_API_KEY=your_s2_api_key

# ============================================================================
# Health Intelligence Engine
# ============================================================================
# Memakai OPENAI_API_KEY di atas. Semua setting lain punya default aman di
# settings.py — tulis di sini hanya bila memang perlu diubah.

# Provider & model LLM (juga dibaca pipeline training).
# LLM_PROVIDER bersifat EKSKLUSIF: "openai" berarti hanya OpenAI yang dicoba.
# Kosongkan untuk memakai semua provider berkredensial dengan fallback otomatis.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini

# API key consumer eksternal: "key:nama_consumer" dipisah koma.
# Kosong = endpoint /api/v1/intelligence/* terbuka (jangan untuk produksi).
# Format: "key:consumer" atau "key:consumer:batas" untuk batas khusus.
# Consumer backend yang melayani banyak pengguna biasanya butuh batas lebih tinggi.
# Ke mana calon consumer mengirim permintaan akses API. Ditampilkan di /docs
# bila diisi. Kosongkan bila belum ada; dokumentasi tidak akan menyebut alamat
# karangan.
API_CONTACT_EMAIL=
API_CONTACT_URL=

INTELLIGENCE_API_KEYS=ht_live_ganti_ini:healthtalk:300/min

# Batas laju per API key untuk /api/v1/intelligence/*. Setiap permintaan
# memanggil LLM + embedding berbayar, jadi batas ini melindungi kuota Anda.
INTELLIGENCE_RATE_LIMIT=60/min

# Berapa lama respons disimpan untuk header X-Idempotency-Key (detik).
IDEMPOTENCY_TTL=86400

# CORS. Origin harus DISEBUT EKSPLISIT — tidak ada wildcard dan tidak ada
# domain bawaan. FRONTEND_URL menerima beberapa origin dipisah koma, jadi
# origin HealthTalk tidak butuh variabel tersendiri.
FRONTEND_URL=https://domain-anda.com,https://healthtalk.example.com

# Host yang dilayani (dipisah koma). Wajib diisi di produksi.
ALLOWED_HOSTS=domain-anda.com

# JANGAN diaktifkan kecuali benar-benar perlu: kredensial lintas origin
# berbahaya bila dikombinasikan dengan pola origin. Frontend Healthify memakai
# header Authorization, bukan cookie, jadi tidak memerlukannya.
# CORS_ALLOW_CREDENTIALS=False
# CORS_ALLOWED_ORIGIN_REGEXES=

# --- Opsional (semua punya default; ubah hanya bila perlu) ---
# EVIDENCE_LINK_CHECK_ENABLED=True        # verifikasi DOI ke registry (jangan dimatikan di produksi)
# EMBEDDINGS_ENABLED=1                    # 0 = retrieval leksikal saja
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=768                # kosong = deteksi otomatis dari tabel embeddings
# INTELLIGENCE_LLM_ENABLED=1              # 0 = jawaban ekstraktif tanpa LLM
